# Generated Xcode project (XcodeGen owns it; signing/team live here, never committed)
*.xcodeproj

# Build output
.build/
.build-xcode/
# Any one-off DerivedData folder named like the above (a `.build-rel`
# release build was once committed by accident and had to be purged
# from history).
.build*/
DerivedData/

# Editor / OS
.vscode/
.DS_Store

# SwiftPM per-user state (schemes, user data)
.swiftpm/

# Release lane output + local ASC credentials
dist/
Scripts/.asc-config
